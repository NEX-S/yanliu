<?xml version="1.0" encoding="UTF-8"?>
<component>
  <name>org.freedesktop.IBus.Yanliu</name>
  <description>Yanliu local Mandarin input for GNOME</description>
  <exec>@PREFIX@/bin/yanliu-ibus --ibus --config @CONFIG@</exec>
  <version>0.1.0</version>
  <author>Yanliu contributors</author>
  <license>GPL-3.0-or-later</license>
  <textdomain>yanliu</textdomain>
  <engines>
    <engine>
      <name>yanliu</name>
      <longname>砚流</longname>
      <description>Local Chinese pinyin input</description>
      <language>zh_CN</language>
      <license>GPL-3.0-or-later</license>
      <author>Yanliu contributors</author>
      <layout>us</layout>
      <rank>80</rank>
    </engine>
  </engines>
</component>
